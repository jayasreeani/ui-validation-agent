{
  "name": "ui-validation-agent",
  "version": "1.0.0",
  "description": "Enterprise AI-powered UI validation agent — Figma vs live web app comparison",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "ui-validate": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/cli.ts validate",
    "validate:figma": "tsx src/cli.ts validate --mode figma",
    "validate:responsive": "tsx src/cli.ts validate --mode responsive",
    "report": "tsx src/cli.ts report",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare:browsers": "playwright install chromium firefox",
    "dashboard": "npm run --prefix dashboard dev"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ui-validation",
    "figma",
    "playwright",
    "visual-regression",
    "design-tokens",
    "gpt-4o"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "openai": "^4.77.0",
    "pdfkit": "^0.15.2",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.8",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
