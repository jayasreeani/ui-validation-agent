# Application under test
APP_URL=https://example.com
# Prefer APP_USERNAME / APP_PASSWORD (Windows already defines USERNAME)
APP_USERNAME=
APP_PASSWORD=
LOGIN_SELECTOR_USER=input[name="username"]
LOGIN_SELECTOR_PASS=input[name="password"]
LOGIN_SELECTOR_SUBMIT=button[type="submit"]

# Figma
FIGMA_TOKEN=
FIGMA_FILE_KEY=
FIGMA_NODE_ID=

# OpenAI / Azure OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Set PROVIDER=azure to use Azure OpenAI
AI_PROVIDER=openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Visual comparison
PIXEL_DIFF_THRESHOLD=0.1
PIXEL_DIFF_MAX_PERCENT=2.5
AI_VISION_ENABLED=true

# Browser
BROWSER=chromium
HEADLESS=true
NAVIGATION_TIMEOUT_MS=30000
SCREENSHOT_DIR=output/screenshots

# Responsive viewports (comma-separated WxH)
VIEWPORTS=1920x1080,1366x768,768x1024,390x844

# Design token tolerances
COLOR_TOLERANCE=8
SPACING_TOLERANCE_PX=4
FONT_SIZE_TOLERANCE_PX=1

# Jira (optional)
JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=

# Reporting
OUTPUT_DIR=output
REPORT_TITLE=UI Validation Report

# Logging
LOG_LEVEL=info
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000
